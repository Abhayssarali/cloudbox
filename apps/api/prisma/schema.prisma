// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(USER)
  quotaBytes   BigInt   @default(0)
  usedBytes    BigInt   @default(0)
  groupId      String?
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  group        Group?   @relation(fields: [groupId], references: [id])
  agents           Agent[]       @relation("OwnedAgents")
  allocatedAgents  Agent[]       @relation("AllocatedUserAgents")
  ownedGroups      Group[]       @relation("GroupOwner")
  activityLogs     ActivityLog[]

  @@map("users")
}

model Agent {
  id               String      @id @default(uuid())
  cloudId          String      @unique
  userId           String
  publicKey        String
  status           AgentStatus @default(OFFLINE)
  version          String?
  lastHeartbeat    DateTime?
  totalDiskBytes   BigInt?
  freeDiskBytes    BigInt?
  createdAt        DateTime    @default(now())
  allocatedUserId  String?
  allocatedGroupId String?
  user             User        @relation("OwnedAgents", fields: [userId], references: [id])
  allocatedUser    User?       @relation("AllocatedUserAgents", fields: [allocatedUserId], references: [id])
  allocatedGroup   Group?      @relation("AllocatedGroupAgents", fields: [allocatedGroupId], references: [id])
  files            File[]

  @@map("agents")
}

model File {
  id         String        @id @default(uuid())
  agentId    String
  path       String
  name       String
  size       BigInt
  mimeType   String?
  isFolder   Boolean       @default(false)
  parentId   String?
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  agent      Agent         @relation(fields: [agentId], references: [id])
  shareLinks ShareLink[]
  versions   FileVersion[]

  @@unique([agentId, path])
  @@index([deletedAt])
  @@map("files")
}

model ShareLink {
  id        String    @id @default(uuid())
  fileId    String
  token     String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model FileVersion {
  id            String   @id @default(uuid())
  fileId        String
  versionNumber Int
  size          BigInt
  storagePath   String
  createdAt     DateTime @default(now())
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_versions")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AgentStatus {
  ONLINE
  OFFLINE
}

model Group {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  inviteCode      String   @unique @default(cuid())
  ownerId         String
  createdAt       DateTime @default(now())
  users           User[]
  allocatedAgents Agent[]  @relation("AllocatedGroupAgents")
  owner           User     @relation("GroupOwner", fields: [ownerId], references: [id])

  @@map("groups")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model TotpSetup {
  id        String   @id @default(uuid())
  userId    String   @unique
  secret    String
  createdAt DateTime @default(now())

  @@map("totp_setups")
}
