NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://cloudbox:cloudbox_secret@localhost:5432/cloudbox_db"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-strong-random-secret"
JWT_REFRESH_SECRET="change-me-strong-random-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Session (used for OAuth state only)
SESSION_SECRET="change-me-strong-session-secret"

# Google OAuth — create at console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# CORS - set to your frontend URL (e.g. https://yourapp.vercel.app in production)
CORS_ORIGIN="http://localhost:3000"
