[Unit]
Description=CloudBox Agent Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change to the path of your CloudBox installation
WorkingDirectory=/opt/cloudbox/apps/agent
# Run using Node.js (assuming you've built with `pnpm run build`)
ExecStart=/usr/bin/node dist/index.js start
Restart=on-failure
RestartSec=5
# Adjust user as needed
User=root
Environment=NODE_ENV=production
# Update URLs to match your deployed CloudBox domains
Environment=API_URL=https://cloudbox.com/api
Environment=GATEWAY_URL=wss://gateway.cloudbox.com

[Install]
WantedBy=multi-user.target
